# @import(../../, pick=[NODE_ENV, BETTER_AUTH_SECRET, ALCHEMY_PASSWORD, EMAIL_FROM, SEPOMEX_URL, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY, WEB_DOMAIN])
# Deployed stages read their secrets from Infisical through `.env.testing` and `.env.production`.
# @currentEnv=$APP_ENV
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=7b412229-f499-48f6-a88e-1a37c648ed7e,
#   environment=$APP_ENV,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ---

# Deploy stage; picks `.env.[APP_ENV]` and the Infisical environment of the same slug.
# Separate from NODE_ENV because alchemy runs every stage with NODE_ENV=production.
# @public @type=enum(development, testing, production)
APP_ENV=development

# Infisical machine identity (Universal Auth); only deploys need it, keep it in `.env.local`.
# @public @type=infisicalClientId @required=forEnv(testing, production)
INFISICAL_CLIENT_ID=

# @sensitive @internal @type=infisicalClientSecret @required=forEnv(testing, production)
INFISICAL_CLIENT_SECRET=
