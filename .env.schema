# Single source of truth for every env var. Packages import what they need
# with `# @import(../../, pick=[...])`. Dev defaults only; never real secrets.
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# ---

# Runtime environment
# @public @type=enum(development, production, test)
NODE_ENV=development

# Better Auth signing secret (dev default; deploys override via real env vars)
# @type=string(minLength=32)
BETTER_AUTH_SECRET="dev-only-better-auth-secret-not-for-prod"

# Public base URL of the web app (portless dev URL)
# @type=url
BETTER_AUTH_URL=https://horkos.localhost

# Cloudflare Email Service sender address; production must use an onboarded domain.
# @public @type=email
EMAIL_FROM=no-reply@example.com

# Base URL of our Sepomex postal code API (https://github.com/IcaliaLabs/sepomex), on the VPS.
# Only postal codes travel to it, never who they belong to.
# @public @type=url
SEPOMEX_URL=http://olimpo-sepomex-ke5xjs-2ae574-2-24-73-183.sslip.io

# Alchemy state encryption password (dev default; deploys override via real env vars)
ALCHEMY_PASSWORD="dev-only-alchemy-password"
